# Base URL of the SkyReserve backend API.
#
# Dev (backend running locally):
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Prod (point this at your deployed backend):
# VITE_API_BASE_URL=https://your-backend-domain.com/api/v1

# Base URL for the Socket.IO connection (real-time seat lock updates).
# This is usually the SAME domain as your backend, without the /api/v1 path.
#
# Dev (backend running locally):
VITE_SOCKET_URL=http://localhost:5000

# Prod (point this at your deployed backend, no path):
# VITE_SOCKET_URL=https://your-backend-domain.com