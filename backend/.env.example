# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MySQL, used by Prisma) ─────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/skyreserve"

# ── Redis (seat locking) ─────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# Seconds a seat stays locked for one user before it's released
# back to the pool if they don't complete payment
SEAT_LOCK_TTL=300

# ── JWT ───────────────────────────────────────────────────
# Use long, random strings in real environments, e.g.
# `openssl rand -base64 64`
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES="7d"

# ── CORS / Cookies ────────────────────────────────────────
# Origin(s) allowed to call this API and receive the refresh
# cookie. Comma-separate multiple origins, no trailing slash.
# Dev:  http://localhost:5173
# Prod: https://your-frontend-domain.com
CLIENT_URL="http://localhost:5173"

# ── Conversational booking agent (Gemini, free tier) ──────
# Get a free key at https://aistudio.google.com/apikey
# (no credit card required for Flash / Flash-Lite models)
GEMINI_API_KEY="your-gemini-api-key-here"

# Flash models are the free-tier ones. Flash-Lite is faster/cheaper
# but slightly weaker at picking the right tool; Flash is the better
# default for an agent that has to reason about missing info.
AGENT_MODEL_NAME="gemini-3.6-flash"

# Safety cap on how many tool-call round-trips one chat turn can make
# before the agent gives up and asks the user to simplify their request.
AGENT_MAX_TURNS=6
