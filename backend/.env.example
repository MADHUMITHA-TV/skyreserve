# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MySQL, used by Prisma) ─────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/skyreserve"

# ── Redis (seat locking) ─────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# Seconds a seat stays locked for one user before it's released
# back to the pool if they don't complete payment
SEAT_LOCK_TTL=300

# ── JWT ───────────────────────────────────────────────────
# Use long, random strings in real environments, e.g.
# `openssl rand -base64 64`
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES="7d"

# ── CORS / Cookies ────────────────────────────────────────
# Origin(s) allowed to call this API and receive the refresh
# cookie. Comma-separate multiple origins, no trailing slash.
# Dev:  http://localhost:5173
# Prod: https://your-frontend-domain.com
CLIENT_URL="http://localhost:5173"