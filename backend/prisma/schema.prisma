generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum TokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  CANCELLED
  COMPLETED
}

enum AircraftStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
}

model User {
  id          String    @id @default(cuid())
  firstName   String    @db.VarChar(100)
  lastName    String    @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  phone       String?   @unique @db.VarChar(20)
  gender      Gender?
  dateOfBirth DateTime?

  role   Role       @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  emailVerified          Boolean @default(false)
  emailVerificationToken String? @db.VarChar(255)

  passwordResetToken   String?   @db.VarChar(255)
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  bookings      Booking[]

  agentConversations AgentConversation[]
  agentToolCalls     AgentToolCall[]
  policySupportLogs  PolicySupportLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id String @id @default(cuid())

  token String @unique @db.VarChar(500)

  type TokenType @default(REFRESH)

  expiresAt DateTime

  revoked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Airport {
  id String @id @default(cuid())

  name    String @db.VarChar(150)
  code    String @unique @db.VarChar(10)
  city    String @db.VarChar(100)
  country String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departureFlights Flight[] @relation("DepartureAirport")
  arrivalFlights   Flight[] @relation("ArrivalAirport")

  @@index([code])
  @@index([city])
}

model Airline {
  id String @id @default(cuid())

  name String @db.VarChar(150)
  code String @unique @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aircrafts Aircraft[]
  flights   Flight[]

  @@index([code])
}

model Aircraft {
  id String @id @default(cuid())

  model              String @db.VarChar(100)
  registrationNumber String @unique @db.VarChar(50)

  totalSeats Int

  status AircraftStatus @default(ACTIVE)

  airlineId String

  airline Airline @relation(fields: [airlineId], references: [id], onDelete: Cascade)

  flights Flight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([airlineId])
}

model Flight {
  id String @id @default(cuid())

  flightNumber String @unique @db.VarChar(20)

  departureTime DateTime
  arrivalTime   DateTime

  status FlightStatus @default(SCHEDULED)

  airlineId  String
  aircraftId String

  departureAirportId String
  arrivalAirportId   String

  airline Airline @relation(fields: [airlineId], references: [id])

  aircraft Aircraft @relation(fields: [aircraftId], references: [id])

  departureAirport Airport @relation("DepartureAirport", fields: [departureAirportId], references: [id])

  arrivalAirport Airport @relation("ArrivalAirport", fields: [arrivalAirportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats    FlightSeat[]
  bookings Booking[]

  @@index([flightNumber])
  @@index([departureAirportId])
  @@index([arrivalAirportId])
  @@index([airlineId])
}

model FlightSeat {
  id String @id @default(cuid())

  seatNumber String @db.VarChar(10)

  status SeatStatus @default(AVAILABLE)

  flightId String

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  bookingId String?

  booking Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flightId, seatNumber])
  @@index([flightId])
}

model Booking {
  id String @id @default(cuid())

  bookingCode String @unique @db.VarChar(20)

  status BookingStatus @default(PENDING)

  totalAmount Decimal @db.Decimal(10, 2)

  userId String

  flightId String

  user User @relation(fields: [userId], references: [id])

  flight Flight @relation(fields: [flightId], references: [id])

  seats FlightSeat[]

  passengers BookingPassenger[]

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([flightId])
}

model BookingPassenger {
  id String @id @default(cuid())

  firstName String @db.VarChar(100)
  lastName  String @db.VarChar(100)

  age Int?

  gender Gender?

  bookingId String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model Payment {

  id             String   @id @default(cuid())

  bookingId      String   @unique

  amount         Decimal
  currency       String   @default("INR")

  paymentMethod  PaymentMethod
  status         PaymentStatus

  transactionId  String?  @unique

  idempotencyKey String @unique

  paidAt         DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ---------------------------------------------------------------------
// Conversational booking agent — chat sessions + tool-call audit log.
// Added for the /api/agent/chat feature. See agent.tools.js for the
// tool schemas these entries correspond to.
// ---------------------------------------------------------------------

enum ToolCallStatus {
  SUCCESS
  ERROR
}

model AgentConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set once the agent creates a booking in this conversation, so an
  // eval script can quickly find "conversations that resulted in a
  // booking" vs. "conversations that didn't" without joining tool calls.
  resultingBookingId String?

  // Gemini's own conversation format (contents: [{role, parts}]),
  // persisted so multi-turn context survives between HTTP requests —
  // the Gemini API itself is stateless per call. Swapping LLM providers
  // later means this shape changes too, which is expected and fine;
  // it's an implementation detail of agent.llm.js, not a public contract.
  historyJson Json?

  // When the agent wants to call a SENSITIVE_TOOLS tool (confirm_payment,
  // cancel_booking), execution pauses here instead of running immediately.
  // Shape: { toolName, args, functionCallId }. Cleared once the user
  // explicitly confirms or declines. See agent.orchestrator.js.
  pendingActionJson Json?

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  toolCalls AgentToolCall[]

  @@index([userId])
  @@index([startedAt])
}

model AgentToolCall {
  id String @id @default(cuid())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Denormalized alongside conversationId so eval queries like "all of
  // this user's tool calls across every conversation" don't need a join.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  toolName String @db.VarChar(100)

  // Exact arguments the LLM produced, and exactly what came back from
  // the real endpoint — this pairing is the reasoning trace.
  input  Json
  output Json?

  status       ToolCallStatus
  errorMessage String?        @db.Text

  durationMs Int?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([toolName])
  @@index([createdAt])
}

// ---------------------------------------------------------------------
// RAG support chatbot — policy document chunks + their embeddings.
// No dedicated vector DB: the corpus is small (a few policy docs), so
// embeddings are stored as JSON and compared with brute-force cosine
// similarity in Node at query time (see policy.retriever.js). Revisit
// this if the corpus grows into the thousands of chunks.
// ---------------------------------------------------------------------

model PolicyChunk {
  id String @id @default(cuid())

  // Which source file this came from, e.g. "baggage-policy.md" — lets
  // an eval set check retrieval quality per-policy-area.
  source String

  // The "## Heading" this chunk falls under, kept alongside the content
  // both for citation ("According to the Baggage Policy > Excess Baggage
  // Charges...") and because prepending it to the embedded text improves
  // retrieval on heading-like queries.
  sectionTitle String?

  chunkIndex Int
  content    String @db.Text

  // 384-dim vector from Xenova/all-MiniLM-L6-v2, stored as a plain JSON
  // array (MySQL has no native vector type).
  embedding Json

  createdAt DateTime @default(now())

  @@index([source])
}

// ---------------------------------------------------------------------
// RAG support chatbot — one row per question asked, for the same
// eval-set purpose as AgentToolCall: lets you check retrieval quality
// (which chunks got pulled) against the answer that was actually given.
// ---------------------------------------------------------------------

model PolicySupportLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  question String @db.Text

  // IDs of the PolicyChunk rows retrieval selected for this question, in
  // rank order — lets an eval script check "did retrieval pick the right
  // chunks" separately from "was the generated answer good."
  retrievedChunkIds Json

  answer String @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
